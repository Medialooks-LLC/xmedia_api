<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultItems>true</EnableDefaultItems>
    <AvaloniaVersion>11.0.0</AvaloniaVersion>
    <OutputPath Condition="'$(UsingCMake)' != 'true'">../build_output/$(Configuration)/</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.2" />
    <PackageReference Include="Avalonia.X11" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.2" />
    <PackageReference Include="SDL3-CS" Version="3.2.18" />
    <PackageReference Include="SDL3-CS.Native" Version="3.2.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dev_tools\Medialooks.XMedia.DevTools.csproj" />
    <ProjectReference Include="..\src\Medialooks.XMedia.csproj" />
  </ItemGroup>
</Project>
